---
export interface ActiveCodeItem {
  code: string;
  reward: string;
  added: string;
  source: 'Official Discord Announcement' | 'CCU Milestone' | 'Server Restart Compensation' | 'Version Update Reward';
}

export interface ExpiredCodeItem {
  code: string;
  reward: string;
}

interface Props {
  activeCodes?: ActiveCodeItem[];
  expiredCodes?: ExpiredCodeItem[];
}

const { activeCodes = [], expiredCodes = [] } = Astro.props;
---

<div class="codes-section">
  <!-- Table 1: Active Verified Working Codes -->
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th style="min-width: 170px;">Code</th>
          <th>Reward</th>
          <th style="min-width: 110px;">Added</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        {activeCodes.length === 0 ? (
          <tr>
            <td colspan="4" style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
              <p style="font-size: 1.05rem; margin-bottom: 0.25rem; color: var(--text-secondary);">
                <strong>No active codes right now, this page is checked daily.</strong>
              </p>
              <span style="font-size: 0.875rem;">
                New codes typically drop during CCU milestones or emergency server maintenance restarts.
              </span>
            </td>
          </tr>
        ) : (
          activeCodes.map((item) => (
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 0.5rem; justify-content: space-between;">
                  <span class="code-cell">{item.code}</span>
                  <button
                    type="button"
                    class="btn btn-secondary btn-copy"
                    data-code={item.code}
                    title="Click to copy code"
                    aria-label={`Copy code ${item.code}`}
                    style="padding: 0.25rem 0.65rem; font-size: 0.78rem; flex-shrink: 0;"
                  >
                    Copy
                  </button>
                </div>
              </td>
              <td style="color: #fef08a; font-weight: 500;">{item.reward}</td>
              <td style="color: var(--text-secondary); font-size: 0.875rem;">{item.added}</td>
              <td>
                <span class="badge badge-amber" style="font-size: 0.75rem; white-space: nowrap;">
                  {item.source}
                </span>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  <!-- Table 2: Expired Codes Archive -->
  <h3 style="margin-top: 2.5rem; margin-bottom: 0.75rem;">Expired Fallen Lineage Codes Archive</h3>
  <p style="font-size: 0.925rem; color: var(--text-secondary); margin-bottom: 1rem;">
    The following codes have been verified as expired following subsequent game updates. Listed for historical reference so you don't waste time trying invalid keys:
  </p>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Expired Code</th>
          <th>Former Reward</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {expiredCodes.length === 0 ? (
          <tr>
            <td colspan="3" style="text-align: center; padding: 1.5rem; color: var(--text-muted);">
              <em>No expired codes archived yet.</em>
            </td>
          </tr>
        ) : (
          expiredCodes.map((item) => (
            <tr>
              <td>
                <span class="code-cell code-expired" style="text-decoration: line-through; opacity: 0.7;">
                  {item.code}
                </span>
              </td>
              <td style="color: var(--text-muted);">{item.reward}</td>
              <td>
                <span class="badge badge-red" style="font-size: 0.75rem;">Expired</span>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</div>

<script>
  // Pure lightweight native copy logic with tactile visual feedback
  document.querySelectorAll('.btn-copy').forEach((button) => {
    button.addEventListener('click', () => {
      const code = button.getAttribute('data-code');
      const btn = button as HTMLElement;
      if (code) {
        navigator.clipboard.writeText(code).then(() => {
          const originalText = btn.textContent;
          btn.textContent = 'Copied ✓';
          btn.style.backgroundColor = 'rgba(16, 185, 129, 0.25)';
          btn.style.borderColor = 'rgba(16, 185, 129, 0.6)';
          btn.style.color = '#34d399';
          setTimeout(() => {
            btn.textContent = originalText;
            btn.style.backgroundColor = '';
            btn.style.borderColor = '';
            btn.style.color = '';
          }, 1800);
        });
      }
    });
  });
</script>
