---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items = [] } = Astro.props;
---

<div class="faq-list">
  {items.map((item) => (
    <details class="faq-item">
      <summary class="faq-summary">{item.question}</summary>
      <div class="faq-content">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>
