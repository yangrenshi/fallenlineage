---
import Base from '../layouts/Base.astro';

const title = "Fallen Lineage Update Notes & Patch History";
const description = "Browse all Fallen Lineage updates, balance changes, and official patch history in reverse chronological order with links to relevant classes and mechanics.";
const h1 = "Fallen Lineage Updates";

const siblingLinks = [
  { title: "Roblox Codes", href: "/codes", desc: "Redeem new milestone codes added in recent patches." },
  { title: "Class Tier List", href: "/tier-list", desc: "See how latest balance shifts impact character rankings." },
  { title: "Official Trello", href: "/trello", desc: "Inspect developer roadmaps for upcoming patches." }
];

const lastUpdatedDate = "November 16, 2026";
---

<Base
  title={title}
  description={description}
  h1={h1}
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-amber">Patch Log</span>
    <h1 style="margin-top: 0.75rem;">{h1}</h1>
    <div class="meta-banner">
      <span><strong>Archive:</strong> Complete Patch History</span>
      <span>&bull;</span>
      <span><strong>Last Synchronized:</strong> {lastUpdatedDate}</span>
    </div>
    <p>
      Review all historical updates, balance adjustments, hotfixes, and content expansions for <strong>Fallen Lineage</strong> on Roblox in reverse chronological order.
    </p>
  </div>

  <section>
    <h2>Update v1.0.4 – November 2026</h2>
    <div class="callout callout-info">
      <p style="margin-bottom: 0.25rem;"><strong>Patch Status:</strong> Live on all Roblox game servers</p>
      <p style="margin-bottom: 0; font-size: 0.9rem; color: var(--text-muted);">Release Date: November 2026</p>
    </div>
    <ul>
      <li><strong>Class Balance:</strong> Readjusted mana consumption curves for high-tier elemental spells. See updated analysis in our <a href="/tier-list">Class Tier List</a>.</li>
      <li><strong>Solo Progression:</strong> Tuned enemy health thresholds in early dungeon chambers to improve the new player experience. Check our <a href="/guides/beginner">Beginner Guide</a> for updated route paths.</li>
      <li><strong>Reward Codes:</strong> Released new community celebration codes redeemable on our <a href="/codes">Roblox Codes</a> page.</li>
      <li><strong>Bug Fixes:</strong> Fixed an initiative gauge issue where dual-wielding characters occasionally skipped turn calculations.</li>
    </ul>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Update v1.0.3 – November 2026</h2>
    <div class="callout">
      <p style="margin-bottom: 0.25rem;"><strong>Patch Status:</strong> Archived Release</p>
      <p style="margin-bottom: 0; font-size: 0.9rem; color: var(--text-muted);">Release Date: Early November 2026</p>
    </div>
    <ul>
      <li><strong>Classes Expansion:</strong> Introduced tier-2 mastery nodes for Vanguard and Cleric paths. Read full details in our <a href="/classes">Classes Guide</a>.</li>
      <li><strong>Trello Reorganization:</strong> Developers overhauled their public planning boards with detailed item drop lists. See how to read it on our <a href="/trello">Trello Directory</a>.</li>
      <li><strong>Performance:</strong> Optimized network serialization to reduce lag spikes in multiplayer dungeon rooms.</li>
    </ul>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Update v1.0.2 – October 2026</h2>
    <div class="callout">
      <p style="margin-bottom: 0.25rem;"><strong>Patch Status:</strong> Foundation Milestone</p>
      <p style="margin-bottom: 0; font-size: 0.9rem; color: var(--text-muted);">Release Date: Late October 2026</p>
    </div>
    <ul>
      <li>Initial public release of the core roguelite turn-based dungeon crawl system on Roblox.</li>
      <li>Launched four foundational class archetypes with unique turn commands.</li>
      <li>Implemented the starter sanctuary redemption kiosk and beginner talent tree.</li>
    </ul>
  </section>
</Base>
