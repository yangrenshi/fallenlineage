---
import Base from '../layouts/Base.astro';
import CodeTable, { type ActiveCodeItem, type ExpiredCodeItem } from '../components/CodeTable.astro';
import Faq from '../components/Faq.astro';

// Hard Rule #7: Title, H1, and canonical must remain identical
const title = "Fallen Lineage Roblox Codes (November 2026)";
const description = "Looking for working Fallen Lineage codes? Check our list of active Roblox codes for free Reset Orbs, reroll tokens, and lives, plus redemption steps.";
const h1 = "Fallen Lineage Roblox Codes";

// Hard Rule #1: Date dynamically evaluated at build time (never hardcoded)
const now = new Date();
const buildDateFormatted = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC'
}).format(now);
const dateModified = now.toISOString();
const datePublished = "2026-11-16T10:40:00Z";

// Hard Rule #2: Verified active codes with required 4 columns
// Sources strictly restricted to official channels
const activeCodes: ActiveCodeItem[] = [
  {
    code: "mybelovedcrits",
    reward: "3 Reset Orbs",
    added: "Nov 15, 2026",
    source: "Server Restart Compensation"
  },
  {
    code: "400CCU",
    reward: "3 Reroll Tokens, 1 Life",
    added: "Nov 12, 2026",
    source: "CCU Milestone"
  },
  {
    code: "UPDATE2",
    reward: "2 Reroll Tokens, 2 Lives",
    added: "Nov 14, 2026",
    source: "Version Update Reward"
  },
  {
    code: "SOMANYSHUTDOWNS",
    reward: "Free rewards",
    added: "Nov 13, 2026",
    source: "Server Restart Compensation"
  },
  {
    code: "PARAGUAY",
    reward: "Free rewards",
    added: "Nov 13, 2026",
    source: "Official Discord Announcement"
  }
];

const expiredCodes: ExpiredCodeItem[] = [
  { code: "EARLY2", reward: "Free rewards" },
  { code: "UPDATE1", reward: "Free rewards" }
];

// Hard Rule #4: FAQs directly targeted at real search queries (2-3 concise, fact-packed sentences)
const faqItems = [
  {
    question: "codes for fallen lineage",
    answer: "Official codes for Fallen Lineage provide essential progression items including Reset Orbs, Reroll Tokens, and extra Lives. These items let players re-allocate build stats and retry dangerous dungeon runs without spending Robux. New codes are released by developer odanos on milestone celebrations and emergency server reboots."
  },
  {
    question: "fallen lineage roblox codes",
    answer: "Fallen Lineage Roblox codes can be redeemed directly in-game through the Shop menu once your account meets the minimum 30-minute playtime threshold. Every code can be claimed only once per Roblox profile. Joining the official developer group on Roblox is mandatory for code verification to succeed."
  },
  {
    question: "fallen lineage tree codes",
    answer: "Many players search for 'tree codes' confusing Fallen Lineage's skill progression with skill-tree mechanics from other Roblox RPGs like Deepwoken. Fallen Lineage does not feature separate 'tree codes'; instead, developers issue Reset Orbs through standard promo codes to let you respec your skill tree and talent choices freely."
  },
  {
    question: "how to redeem codes in fallen lineage",
    answer: "To redeem codes in Fallen Lineage, load into the game hub and click the Shop (crate) icon located at the top-right corner of your screen. Select the 'Codes' tab on the left navigation bar, paste an active code into the text field, and press Redeem. Rewards are deposited immediately into your inventory."
  },
  {
    question: "why is my fallen lineage code not working",
    answer: "The three most common reasons for failed redemptions are: your account has logged under 30 minutes of in-game playtime, you have not joined the official odanos Roblox group, or the code was mistyped due to strict case sensitivity. If all requirements are met and it still fails, the code has expired."
  }
];

// Hard Rule #5: Structured Data (Article + FAQPage)
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

// Hard Rule #6: Related internal link cluster (8 distinct links across all core resources)
const relatedResources = [
  {
    title: "Wiki Homepage",
    href: "/",
    badge: "Hub",
    desc: "Main game overview, tactical turn combat basics, and directory navigation."
  },
  {
    title: "All 6 Classes Guide",
    href: "/classes",
    badge: "Archetypes",
    desc: "Complete mechanics breakdown for Warrior, Rogue, Mage, Lancer, Bard, and Archer."
  },
  {
    title: "Class Tier List",
    href: "/tier-list",
    badge: "Meta",
    desc: "Community evaluation matrix, survival benchmarks, and solo clear speed testing."
  },
  {
    title: "Beginner's Handbook",
    href: "/guides/beginner",
    badge: "Walkthrough",
    desc: "First hour survival checklist, resource banking, and common newbie traps to avoid."
  },
  {
    title: "Trello Notice & Community",
    href: "/trello",
    badge: "Community",
    desc: "Fact check on public boards and verified links to the official Discord and Roblox group."
  },
  {
    title: "Patch History & Updates",
    href: "/updates",
    badge: "Changelog",
    desc: "Chronological archive of server restarts, balance revisions, and developer notices."
  },
  {
    title: "How to Reroll Classes",
    href: "/classes#how-to-reroll-classes",
    badge: "Tokens",
    desc: "Learn how to utilize your redeemed Reroll Tokens to test different archetypes."
  },
  {
    title: "Dungeon Turn Order Guide",
    href: "/guides/beginner#progression-checklist",
    badge: "Combat",
    desc: "Master initiative meters and action economies to survive deep dungeon chambers."
  }
];
---

<Base
  title={title}
  description={description}
  h1={h1}
  datePublished={datePublished}
  dateModified={dateModified}
  extraSchemas={[faqPageSchema]}
>
  <!-- Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" style="margin-bottom: 1.25rem;">
    <ol style="display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.85rem; color: var(--text-muted);">
      <li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
      <li aria-hidden="true" style="color: var(--border-highlight);">&rsaquo;</li>
      <li style="color: var(--accent-amber-light); font-weight: 600;" aria-current="page">Codes</li>
    </ol>
  </nav>

  <!-- Page Header & Hard Rule #1 Build Date Banner -->
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <span class="badge badge-green">Roblox Promo Codes</span>
      <span class="badge badge-amber" style="background: rgba(245, 158, 11, 0.12); border-color: rgba(245, 158, 11, 0.3);">
        Verified Active List
      </span>
    </div>
    
    <h1 style="margin-top: 0.75rem; margin-bottom: 0.5rem;">{h1}</h1>

    <!-- Rule #1: Fixed live update line -->
    <div class="meta-banner" style="background: rgba(18, 23, 35, 0.75); border: 1px solid var(--border-subtle); padding: 0.65rem 1rem; border-radius: var(--radius-md); font-size: 0.9rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 9999px; background: #10b981; box-shadow: 0 0 10px #10b981;"></span>
      <span><strong>Last updated:</strong> {buildDateFormatted} &bull; checked every day</span>
      <span style="color: var(--text-muted);">&bull;</span>
      <span style="color: var(--text-secondary);">Direct from official developer broadcasts</span>
    </div>

    <p style="font-size: 1.05rem; line-height: 1.7; color: var(--text-secondary);">
      Looking for verified, working promo codes for <strong>Fallen Lineage</strong> on Roblox? Grab your free in-game Reset Orbs, Reroll Tokens, and extra Lives below to optimize your character's build and survive deeper subterranean chambers.
    </p>
  </div>

  <!-- Main Section: Active & Expired Code Tables (Hard Rule #2) -->
  <section>
    <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
      <h2 style="margin: 0;">Active Fallen Lineage Codes</h2>
      <span style="font-size: 0.85rem; color: var(--text-muted);">Click "Copy" next to any code for exact casing</span>
    </div>
    <p style="margin-bottom: 1.25rem; color: var(--text-secondary);">
      The table below contains all currently redeemable codes confirmed operational by community reports and developer notices:
    </p>

    <CodeTable activeCodes={activeCodes} expiredCodes={expiredCodes} />
  </section>

  <!-- Hard Rule #3: Redemption Steps & Menu Location -->
  <section style="margin-top: 3.5rem;">
    <h2>How to Redeem Codes in Fallen Lineage</h2>
    <p>
      Redeeming promotional codes in Fallen Lineage is straightforward once your account meets the initial anti-bot criteria:
    </p>

    <div class="grid grid-cols-2" style="margin-top: 1.5rem; gap: 1rem;">
      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">1</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Join Group & Play 30 Mins</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Join the official <a href="https://www.roblox.com/communities/889770537/odanos" target="_blank" rel="noopener noreferrer">odanos Roblox Community</a> and like the game. Your account must log at least <strong>30 minutes of in-game playtime</strong> to unlock the redemption subsystem.
        </p>
      </div>

      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">2</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Open the In-Game Shop</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Spawn into the game hub. Look at the upper-right corner of your screen HUD and click the <strong>Shop / Crate icon</strong> to expand the store menu.
        </p>
      </div>

      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">3</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Switch to Codes Tab</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Navigate through the side tabs inside the shop window and click the <strong>Codes</strong> tab marked with a ticket/gift icon.
        </p>
      </div>

      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">4</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Paste & Redeem</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Paste a working code from our table into the text input box and click <strong>Redeem</strong> to instantly collect your free Reset Orbs, Reroll Tokens, and Lives.
        </p>
      </div>
    </div>

    <!-- Case Sensitivity & Common Failure Points Callout -->
    <div class="callout callout-info" style="margin-top: 1.5rem; padding: 1.5rem;">
      <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-primary); margin-bottom: 0.5rem;">
        ⚠️ Strict Case Sensitivity & Common Redemption Failures
      </h3>
      <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0.75rem;">
        Fallen Lineage codes are <strong>strictly case-sensitive</strong> (for example, typing <code>400ccu</code> instead of <code>400CCU</code> will result in an invalid key error). Always use the one-click copy buttons above to ensure exact capitalization.
      </p>
      <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.9rem; color: var(--text-secondary);">
        <li><strong>Playtime Requirement:</strong> If your account has not accumulated 30 minutes inside a live game server, code submission is locked by the anti-exploit system.</li>
        <li><strong>Group Membership:</strong> Unlocking codes requires being an active member of the creator group (odanos).</li>
        <li><strong>Whitespace & Double Redemption:</strong> Ensure no trailing spaces are copied with your text. Each promotional code can only be claimed once per Roblox account.</li>
      </ul>
    </div>
  </section>

  <!-- Hard Rule #4: FAQs directly targeted at real user search queries -->
  <section style="margin-top: 3.5rem;">
    <h2>Frequently Asked Questions About Fallen Lineage Codes</h2>
    <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
      Answers to common questions gathered from player search queries and community discussions:
    </p>
    <Faq items={faqItems} />
  </section>

  <!-- Hard Rule #6: Related Resources Cluster (8 deep links) -->
  <section style="margin-top: 4rem;">
    <h2>Related Guides & Database Resources</h2>
    <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
      Explore more mechanics, character build ratings, and survival guides across the Fallen Lineage Wiki:
    </p>

    <div class="grid grid-cols-2" style="gap: 1.25rem;">
      {relatedResources.map((item) => (
        <a href={item.href} class="card" style="text-decoration: none; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div class="card-title" style="margin-bottom: 0.5rem; align-items: center;">
              <span style="color: #fff; font-size: 1.05rem;">{item.title}</span>
              <span class="badge badge-amber" style="font-size: 0.72rem; padding: 0.15rem 0.55rem;">{item.badge}</span>
            </div>
            <p style="margin-bottom: 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55;">
              {item.desc}
            </p>
          </div>
          <div style="margin-top: 0.75rem; font-size: 0.85rem; color: var(--accent-amber-light); font-weight: 600;">
            View Resource &rarr;
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
