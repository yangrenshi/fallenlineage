---
import Base from '../layouts/Base.astro';
import CodeTable from '../components/CodeTable.astro';
import Faq from '../components/Faq.astro';

const title = "Fallen Lineage Roblox Codes (November 2026)";
const description = "Looking for working Fallen Lineage codes? Check our list of active Roblox codes for free Reset Orbs, reroll tokens, and lives, plus redemption steps.";
const h1 = "Fallen Lineage Roblox Codes";

// Hard Rule #3: Must link to tier list, trello, and classes
const siblingLinks = [
  { title: "Class Tier List", href: "/tier-list", desc: "See which classes dominate the current dungeon meta." },
  { title: "Trello Notice", href: "/trello", desc: "No official board — real Discord and group links inside." },
  { title: "Classes Guide", href: "/classes", desc: "Detailed breakdown of all available playstyles and kits." }
];

// Verified active promo codes from community guides
const activeCodes = [
  { code: "mybelovedcrits", reward: "3 Reset Orbs", status: "active" as const },
  { code: "400CCU", reward: "3 Reroll Tokens, 1 Life", status: "active" as const },
  { code: "UPDATE2", reward: "2 Reroll Tokens, 2 Lives", status: "active" as const },
  { code: "SOMANYSHUTDOWNS", reward: "Free rewards", status: "active" as const },
  { code: "PARAGUAY", reward: "Free rewards", status: "active" as const }
];

const expiredCodes = [
  { code: "EARLY2", reward: "Free rewards", status: "expired" as const },
  { code: "UPDATE1", reward: "Free rewards", status: "expired" as const }
];

const faqItems = [
  {
    question: "Why is my Fallen Lineage code not working?",
    answer: "Roblox promo codes are strictly case-sensitive. Additionally, Fallen Lineage requires joining the official Roblox group and having at least 30 minutes of in-game playtime before code redemption unlocks."
  },
  {
    question: "Where do developers announce new Fallen Lineage codes?",
    answer: "New promo codes are typically released to celebrate concurrent player milestones (CCU targets), server maintenance downtime compensations, or game updates."
  },
  {
    question: "How often are codes checked and added?",
    answer: "We check and update codes after major server shutdowns, game updates, and community milestones."
  }
];

const lastUpdatedDate = "November 16, 2026";
const dateModified = "2026-11-16T10:42:00Z";
---

<Base
  title={title}
  description={description}
  h1={h1}
  dateModified={dateModified}
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-green">Roblox Promo Codes</span>
    <h1 style="margin-top: 0.75rem;">{h1}</h1>
    <div class="meta-banner">
      <span><strong>Status:</strong> Reported Working</span>
      <span>&bull;</span>
      <span><strong>Last Checked:</strong> {lastUpdatedDate}</span>
    </div>
    <p>
      Looking for working promo codes for <strong>Fallen Lineage</strong> on Roblox? Grab your free in-game Reset Orbs, reroll tokens, and extra lives to advance your character's progression.
    </p>
  </div>

  <section>
    <h2>Active Fallen Lineage Codes</h2>
    <p>
      Below is the list of active redemption codes for Fallen Lineage. Reported working by community players following recent server restarts.
    </p>

    <CodeTable activeCodes={activeCodes} expiredCodes={expiredCodes} />
  </section>

  <section style="margin-top: 3.5rem;">
    <h2>How to Redeem Codes in Fallen Lineage</h2>
    <p>
      Redeeming promo codes inside Fallen Lineage takes less than a minute once you meet the playtime threshold:
    </p>

    <div class="grid grid-cols-2" style="margin-top: 1.5rem; gap: 1rem;">
      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">1</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Join Group & Play 30 Mins</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Join the official Fallen Lineage Roblox group and like the game. Your account must log at least <strong>30 minutes</strong> of playtime before redemption unlocks.
        </p>
      </div>

      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">2</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Open the In-Game Shop</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Spawn into the game hub. Look at the upper right portion of your HUD and click the <strong>Shop / Crate icon</strong> to reveal the menu.
        </p>
      </div>

      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">3</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Switch to Codes Tab</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Navigate through the side tabs inside the shop window and select the <strong>Codes</strong> tab marked with a ticket/gift icon.
        </p>
      </div>

      <div class="card" style="position: relative;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 9999px; background: var(--accent-amber); color: #000; font-weight: 800; font-size: 0.9rem;">4</span>
          <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">Paste & Redeem</h3>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
          Paste an active promo code from our table into the input box and press <strong>Redeem</strong> to instantly collect your Reset Orbs and tokens.
        </p>
      </div>
    </div>

    <div class="callout" style="margin-top: 1.5rem;">
      <p style="margin-bottom: 0;">
        💡 <strong>Pro Tip:</strong> Codes can only be claimed once per account. Use the one-click copy buttons in our table above to guarantee exact casing.
      </p>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Where to Find New Codes</h2>
    <p>
      To catch newly issued codes as soon as servers reboot:
    </p>
    <ul>
      <li>Follow the developers' group announcements on Roblox.</li>
      <li>Bookmark our <a href="/codes">Roblox Codes</a> page for reported working codes after server shutdowns.</li>
      <li>Monitor announcements in the official Discord and read our <a href="/trello">Trello notice</a>.</li>
    </ul>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Frequently Asked Questions</h2>
    <Faq items={faqItems} />
  </section>
</Base>
