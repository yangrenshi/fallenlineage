---
import Base from '../layouts/Base.astro';

const title = "Fallen Lineage Wiki – Classes, Codes, Tier List & Guides";
const description = "Discover Fallen Lineage on Roblox. Explore our comprehensive wiki featuring working codes, class tier lists, real community hubs, and beginner guides.";
const h1 = "Fallen Lineage Wiki";

const siblingLinks = [
  { title: "Roblox Codes", href: "/codes", desc: "Get active promo codes and free rewards." },
  { title: "Class Tier List", href: "/tier-list", desc: "Meta rankings from S to B tier." },
  { title: "All Classes", href: "/classes", desc: "Detailed playstyles, roles, and kits." },
  { title: "Trello Notice", href: "/trello", desc: "Board status and official community hubs." }
];
---

<Base
  title={title}
  description={description}
  h1={h1}
  type="website"
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 2.5rem; padding: 2.5rem 1.75rem; background: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.12), transparent 70%), rgba(18, 23, 35, 0.6); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08); text-align: center;">
    <span class="badge badge-amber" style="padding: 0.35rem 0.85rem; font-size: 0.775rem;">Community Wiki &bull; Turn-Based Roguelite</span>
    <h1 style="margin-top: 1rem; margin-bottom: 1rem; font-size: 2.85rem;">{h1}</h1>
    <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 760px; margin: 0 auto; line-height: 1.75;">
      Your definitive, community-driven database for Fallen Lineage on Roblox. Explore reported working promo codes, class kits, tier rankings, and real developer hubs.
    </p>
  </div>

  <section>
    <h2>What is Fallen Lineage?</h2>
    <p>
      <strong>Fallen Lineage</strong> is a hardcore, turn-based roguelite role-playing game on Roblox that blends tactical round-based strategy with deep character progression, permadeath dungeon mechanics, and challenging boss encounters. Unlike fast-paced hack-and-slash titles, Fallen Lineage rewards calculated turn planning, elemental synergy, and defensive counter-play.
    </p>
    <p>
      Whether you are embarking on your very first expedition into the subterranean crypts or optimizing a high-tier endgame character build, this wiki gathers every crucial game system—from verified character classes to our dedicated <a href="/codes">Roblox codes directory</a>—into one fast, clean, ad-free resource.
    </p>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Core Database Navigation</h2>
    <p>Select a portal below to access official references, mechanics, and guides:</p>
    
    <div class="grid grid-cols-2" style="margin-top: 1.25rem;">
      <a href="/codes" class="card" style="text-decoration: none;">
        <div class="card-title">
          <span>Roblox Codes</span>
          <span class="badge badge-green">Daily Check</span>
        </div>
        <p>Looking for active keys? All working Reset Orbs, Reroll Tokens, and Lives are tracked on our dedicated codes page.</p>
        <span class="btn btn-secondary" style="font-size: 0.825rem; width: fit-content;">Open Codes Directory &rarr;</span>
      </a>

      <a href="/tier-list" class="card" style="text-decoration: none;">
        <div class="card-title">
          <span>Class Tier List</span>
          <span class="badge badge-amber">Meta</span>
        </div>
        <p>Comprehensive S/A/B tier rankings analyzing solo dungeon speed and boss viability.</p>
        <span class="btn btn-secondary" style="font-size: 0.825rem; width: fit-content;">Check Class Rankings &rarr;</span>
      </a>

      <a href="/classes" class="card" style="text-decoration: none;">
        <div class="card-title">
          <span>Classes Directory</span>
          <span class="badge badge-amber">Guides</span>
        </div>
        <p>In-depth breakdowns of combat roles, skill trees, playstyles, and target builds.</p>
        <span class="btn btn-secondary" style="font-size: 0.825rem; width: fit-content;">Explore Archetypes &rarr;</span>
      </a>

      <a href="/trello" class="card" style="text-decoration: none;">
        <div class="card-title">
          <span>Trello Status</span>
          <span class="badge badge-amber">Reference</span>
        </div>
        <p>Honest guide explaining board status and direct links to verified Discord and Roblox hubs.</p>
        <span class="btn btn-secondary" style="font-size: 0.825rem; width: fit-content;">Read Trello Notice &rarr;</span>
      </a>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Recent Game Updates & Highlights</h2>
    <p>
      Stay informed on the latest mechanics, balance adjustments, and patch changes in Fallen Lineage:
    </p>
    <div class="callout callout-info">
      <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-primary);">Development Tracking & Updates</h3>
      <p style="margin-bottom: 0.5rem;">
        Balance revisions, upcoming roadmap milestones, and mechanic cards are actively tracked through the official Discord and server restart broadcasts.
      </p>
      <a href="/updates" style="font-weight: 600; font-size: 0.9rem;">View Update Status &rarr;</a>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>New to the Game?</h2>
    <p>
      Fallen Lineage can be unforgiving for newcomers. Learn how to navigate your first hour, master turn economy, and avoid costly early build mistakes by reading our dedicated walkthrough:
    </p>
    <p>
      <a href="/guides/beginner" class="btn btn-primary">Open Beginner's Starter Guide &rarr;</a>
    </p>
  </section>
</Base>
