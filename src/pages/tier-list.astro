---
import Base from '../layouts/Base.astro';

const title = "Fallen Lineage Tier List – Best Classes Ranked";
const description = "Explore the Fallen Lineage class tier list evaluation framework. Review testing criteria and current ranking status for all 6 character archetypes.";
const h1 = "Fallen Lineage Tier List";

const siblingLinks = [
  { title: "Classes Guide", href: "/classes", desc: "Detailed breakdown of mechanics and skill rotations." },
  { title: "Roblox Codes", href: "/codes", desc: "Redeem free spins and gems to reroll stats." },
  { title: "Official Trello", href: "/trello", desc: "Check upcoming developer balance roadmaps." }
];

const lastUpdatedDate = "November 16, 2026";

const classesStatus = [
  { name: "Warrior", icon: "🛡️", badgeClass: "badge-warrior", role: "Tank / Frontline Melee", status: "Pending Verification", note: "Testing solo clear stability and damage mitigation." },
  { name: "Rogue", icon: "🗡️", badgeClass: "badge-rogue", role: "Single-Target Assassin", status: "Pending Verification", note: "Testing boss burst efficiency and evasion scaling." },
  { name: "Mage", icon: "🔮", badgeClass: "badge-mage", role: "AoE Elemental Caster", status: "Pending Verification", note: "Testing wave clear times across mid-tier dungeons." },
  { name: "Lancer", icon: "⚡", badgeClass: "badge-lancer", role: "Armor Piercer / Reach Melee", status: "Pending Verification", note: "Testing armor penetration against armored elites." },
  { name: "Bard", icon: "🎵", badgeClass: "badge-bard", role: "Party Buffer / Turn Support", status: "Pending Verification", note: "Testing co-op party force multiplier and speed buffs." },
  { name: "Archer", icon: "🏹", badgeClass: "badge-archer", role: "Ranged Physical DPS", status: "Pending Verification", note: "Testing kiting safety and ranged single-target DPR." }
];
---

<Base
  title={title}
  description={description}
  h1={h1}
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-amber">Meta Rankings</span>
    <h1 style="margin-top: 0.75rem;">{h1}</h1>
    <div class="meta-banner">
      <span><strong>Category:</strong> PvE & Dungeon Viability</span>
      <span>&bull;</span>
      <span><strong>Status:</strong> Active In-Game Testing</span>
      <span>&bull;</span>
      <span><strong>Updated:</strong> {lastUpdatedDate}</span>
    </div>
    <p>
      Our <strong>Fallen Lineage tier list</strong> tracks how each of the 6 available character classes performs in turn-based combat, dungeon crawl longevity, and boss encounters.
    </p>
  </div>

  <section>
    <h2>S/A/B Class Tier Classification Matrix</h2>
    <p>
      To prevent misleading players with fabricated numerical ratings, all tiers remain strictly <strong>pending in-game verification</strong> until community testing on the current server build is completed.
    </p>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Class</th>
            <th>Combat Role</th>
            <th>Current Tier Status</th>
            <th>Evaluation Focus</th>
          </tr>
        </thead>
        <tbody>
          {classesStatus.map((c) => (
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span>{c.icon}</span>
                  <strong>{c.name}</strong>
                  <span class={`badge ${c.badgeClass}`} style="font-size: 0.75rem; padding: 0.15rem 0.5rem;">{c.name}</span>
                </div>
              </td>
              <td>{c.role}</td>
              <td>
                <span class="badge badge-amber" style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem;">
                  <span style="display: inline-block; width: 6px; height: 6px; border-radius: 9999px; background: var(--accent-amber); animation: pulse 2s infinite;"></span>
                  {c.status}
                </span>
              </td>
              <td style="color: var(--text-secondary); font-size: 0.925rem;">{c.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Evaluation Criteria: How Tiers Are Determined</h2>
    <p>
      Once rankings are populated, each class is evaluated using three strict benchmark metrics:
    </p>

    <div class="grid grid-cols-3" style="margin-top: 1.5rem; gap: 1rem;">
      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 1.5rem; margin-bottom: 0.5rem; display: block;">⚡</span>
          <h3 style="margin-top: 0; color: var(--accent-amber-light); font-size: 1.1rem;">1. DPR & Clear Speed</h3>
          <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
            How swiftly an archetype clears standard mob chambers without letting encounters drag into lethal fatigue cycles.
          </p>
        </div>
      </div>

      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 1.5rem; margin-bottom: 0.5rem; display: block;">🛡️</span>
          <h3 style="margin-top: 0; color: #34d399; font-size: 1.1rem;">2. Survivability & Economy</h3>
          <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
            The archetype's ability to maintain high health and resource stability across multi-floor dungeon crawls without burn.
          </p>
        </div>
      </div>

      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span style="font-size: 1.5rem; margin-bottom: 0.5rem; display: block;">💀</span>
          <h3 style="margin-top: 0; color: #f87171; font-size: 1.1rem;">3. Boss Raid Viability</h3>
          <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
            Direct single-target execution against elite bosses possessing stun counters, enrage timers, and high-damage phases.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section style="margin-top: 3.5rem;">
    <h2>Tier List vs. Classes Guide: Key Differences</h2>
    <p>
      We maintain a strict boundary between our ranking comparisons and mechanical walkthroughs:
    </p>
    <ul>
      <li><strong>Tier List</strong>: Compares overall meta strength, party utility, and relative progression speeds.</li>
      <li><strong>Classes Guide</strong>: Focuses on individual playstyles, skill descriptions, and role tips.</li>
    </ul>
    <p>
      To learn more about the playstyle of each archetype, visit our complete <a href="/classes">Classes Guide</a>.
    </p>
  </section>

  <section style="margin-top: 3.5rem;">
    <h2>Recent Balance Status</h2>
    <p>
      With recent server restarts and adjustments rolling out on Roblox, class damage curves are being re-benchmarked. Check our <a href="/trello">Community & Trello Notice</a> for official developer channels, or visit our <a href="/updates">Updates</a> page for official patch records.
    </p>
  </section>
</Base>
