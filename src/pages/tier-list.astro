---
import Base from '../layouts/Base.astro';

const title = "Fallen Lineage Tier List – Best Classes Ranked";
const description = "Explore the Fallen Lineage class tier list evaluation framework. Review testing criteria and current ranking status for all 6 character archetypes.";
const h1 = "Fallen Lineage Tier List";

const siblingLinks = [
  { title: "Classes Guide", href: "/classes", desc: "Detailed breakdown of mechanics and skill rotations." },
  { title: "Roblox Codes", href: "/codes", desc: "Redeem free spins and gems to reroll stats." },
  { title: "Official Trello", href: "/trello", desc: "Check upcoming developer balance roadmaps." }
];

const lastUpdatedDate = "November 16, 2026";

const classesStatus = [
  { name: "Warrior", role: "Tank / Frontline Melee", status: "Pending Verification", note: "Testing solo clear stability and damage mitigation." },
  { name: "Rogue", role: "Single-Target Assassin", status: "Pending Verification", note: "Testing boss burst efficiency and evasion scaling." },
  { name: "Mage", role: "AoE Elemental Caster", status: "Pending Verification", note: "Testing wave clear times across mid-tier dungeons." },
  { name: "Lancer", role: "Armor Piercer / Reach Melee", status: "Pending Verification", note: "Testing armor penetration against armored elites." },
  { name: "Bard", role: "Party Buffer / Turn Support", status: "Pending Verification", note: "Testing co-op party force multiplier and speed buffs." },
  { name: "Archer", role: "Ranged Physical DPS", status: "Pending Verification", note: "Testing kiting safety and ranged single-target DPR." }
];
---

<Base
  title={title}
  description={description}
  h1={h1}
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-amber">Meta Rankings</span>
    <h1 style="margin-top: 0.75rem;">{h1}</h1>
    <div class="meta-banner">
      <span><strong>Category:</strong> PvE & Dungeon Viability</span>
      <span>&bull;</span>
      <span><strong>Status:</strong> Active In-Game Testing</span>
      <span>&bull;</span>
      <span><strong>Updated:</strong> {lastUpdatedDate}</span>
    </div>
    <p>
      Our <strong>Fallen Lineage tier list</strong> tracks how each of the 6 available character classes performs in turn-based combat, dungeon crawl longevity, and boss encounters.
    </p>
  </div>

  <section>
    <h2>S/A/B Class Tier Classification Matrix</h2>
    <p>
      To prevent misleading players with fabricated numerical ratings, all tiers remain strictly <strong>pending in-game verification</strong> until community testing on the current server build is completed.
    </p>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Class</th>
            <th>Combat Role</th>
            <th>Current Tier Status</th>
            <th>Evaluation Focus</th>
          </tr>
        </thead>
        <tbody>
          {classesStatus.map((c) => (
            <tr>
              <td><strong>{c.name}</strong></td>
              <td>{c.role}</td>
              <td>
                <span class="badge" style="background-color: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                  {c.status}
                </span>
              </td>
              <td>{c.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Evaluation Criteria: How Tiers Are Determined</h2>
    <p>
      Once rankings are populated, each class is evaluated using three strict benchmark metrics:
    </p>

    <div class="card" style="margin-bottom: 1.25rem;">
      <h3 style="margin-top: 0; color: var(--accent-amber-light);">1. Damage Per Round (DPR) & Clear Speed</h3>
      <p>
        How quickly an archetype can clear standard mob chambers without dragging battles into prolonged cycles where mistakes become lethal.
      </p>
    </div>

    <div class="card" style="margin-bottom: 1.25rem;">
      <h3 style="margin-top: 0; color: #34d399;">2. Survivability & Resource Economy</h3>
      <p>
        The ability of a class to sustain health and energy across sequential dungeon floors without depleting emergency consumable vaults.
      </p>
    </div>

    <div class="card">
      <h3 style="margin-top: 0; color: #cbd5e1;">3. Boss Raid Viability</h3>
      <p>
        Effectiveness when facing elite floor bosses that possess special turn triggers, stun resistance, and high-damage phases.
      </p>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Tier List vs. Classes Guide: Key Differences</h2>
    <p>
      We maintain a strict boundary between our ranking comparisons and mechanical walkthroughs:
    </p>
    <ul>
      <li><strong>Tier List</strong>: Compares overall meta strength, party utility, and relative progression speeds.</li>
      <li><strong>Classes Guide</strong>: Focuses on individual playstyles, skill descriptions, and role tips.</li>
    </ul>
    <p>
      To learn more about the playstyle of each archetype, visit our complete <a href="/classes">Classes Guide</a>.
    </p>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Recent Balance Status</h2>
    <p>
      With recent server restarts and adjustments rolling out on Roblox, class damage curves are being re-benchmarked. Check our <a href="/trello">Trello Guide</a> to view direct developer development cards, or visit our <a href="/updates">Updates</a> page for official patch records.
    </p>
  </section>
</Base>
