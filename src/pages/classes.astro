---
import Base from '../layouts/Base.astro';

const title = "Fallen Lineage Classes – All Classes & How They Play";
const description = "Discover all 6 Fallen Lineage classes: Warrior, Rogue, Mage, Lancer, Bard, and Archer. Explore detailed playstyles, roles, and character archetypes.";
const h1 = "Fallen Lineage Classes";

const siblingLinks = [
  { title: "Class Tier List", href: "/tier-list", desc: "Comparative evaluation framework and tier list." },
  { title: "Beginner Guide", href: "/guides/beginner", desc: "First hour tips, turn order, and currency guide." },
  { title: "Roblox Codes", href: "/codes", desc: "Redeem codes for free class rerolls and gems." }
];

const lastUpdatedDate = "November 16, 2026";

const classesList = [
  {
    name: "Warrior",
    role: "Frontline Tank / Melee Brawler",
    style: "Specializes in high physical durability, guarding stances, and counter-attacks. Absorbs heavy blows to protect party members and grind down opposing mobs.",
    bestFor: "Players who prefer dependable survivability, forgiving margins, and direct melee combat."
  },
  {
    name: "Rogue",
    role: "Agile Assassin / Single-Target DPS",
    style: "Focuses on speed, evasion, and rapid multi-hit strikes. Builds combo rhythm to execute high-impact critical hits against priority targets before they can retaliate.",
    bestFor: "Tacticians who enjoy fast turn rotations, risk-reward timing, and single-target boss bursting."
  },
  {
    name: "Mage",
    role: "Ranged Caster / AoE Damage",
    style: "Channels elemental spells to hit multiple enemy targets at once. Offers superior room-clearing capabilities balanced by lower baseline physical defense.",
    bestFor: "Players focused on sweeping mob waves efficiently and exploiting elemental weaknesses."
  },
  {
    name: "Lancer",
    role: "Piercing Fighter / Mid-Range Melee",
    style: "Utilizes polearm thrusts with extended reach. Balances offensive piercing pressure with defensive positioning, breaking through enemy armor ratings.",
    bestFor: "Fighters who want a balance of offensive reach, crowd control stabs, and sturdy resilience."
  },
  {
    name: "Bard",
    role: "Party Buffer / Turn Support",
    style: "Enhances team performance through melody buffs, initiative manipulation, and stat boosts. Keeps teammates acting faster and recovering between intense rounds.",
    bestFor: "Co-op players and strategists who excel at buff management and party force multiplication."
  },
  {
    name: "Archer",
    role: "Ranged Marksman / Physical DPS",
    style: "Delivers precision ranged attacks with bows and arrows. Keeps distance from lethal melee boss strikes while continuously applying steady physical damage.",
    bestFor: "Players who enjoy kiting mechanics, steady ranged physical DPS, and safe distance engagement."
  }
];
---

<Base
  title={title}
  description={description}
  h1={h1}
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-amber">Character Guide</span>
    <h1 style="margin-top: 0.75rem;">{h1}</h1>
    <div class="meta-banner">
      <span><strong>Archetypes:</strong> 6 Distinct Classes</span>
      <span>&bull;</span>
      <span><strong>Verified:</strong> {lastUpdatedDate}</span>
    </div>
    <p>
      Discover all 6 character classes in <strong>Fallen Lineage</strong> on Roblox. Each archetype defines your fundamental combat abilities, weapon affinities, and turn-based tactical loop.
    </p>
  </div>

  <section>
    <h2>All 6 Classes Breakdown</h2>
    <p>
      Explore the verified roster of classes currently available in the game:
    </p>

    <div class="grid grid-cols-2" style="margin-top: 1.5rem;">
      {classesList.map((item) => (
        <div class="card">
          <div class="card-title">
            <span>{item.name}</span>
            <span class="badge badge-amber">{item.name}</span>
          </div>
          <p><strong>Combat Role:</strong> {item.role}</p>
          <p><strong>Playstyle:</strong> {item.style}</p>
          <p style="margin-bottom: 0;"><strong>Best For:</strong> {item.bestFor}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Class Comparison & Tier Rankings</h2>
    <p>
      Curious how these 6 classes stack up in current dungeon progression?
    </p>
    <p>
      Review our <a href="/tier-list">Fallen Lineage Tier List</a> to see comparative evaluation criteria and ongoing meta testing.
    </p>
  </section>

  <section style="margin-top: 3rem;">
    <h2>How to Reroll Classes</h2>
    <p>
      Players can switch classes using Reroll Tokens obtained from dungeon milestones or promo codes. Check our <a href="/codes">Roblox Codes</a> page for active token rewards to test new playstyles without losing overall progression.
    </p>
  </section>
</Base>
