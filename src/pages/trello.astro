---
import Base from '../layouts/Base.astro';

const title = "Fallen Lineage Trello – No Official Board (Real Discord & Group Links)";
const description = "Searching for the Fallen Lineage Trello board? Learn why there is no official public board yet, avoid fake links, and find real Discord and community hubs.";
const h1 = "Fallen Lineage Trello";

const siblingLinks = [
  { title: "Roblox Codes", href: "/codes", desc: "Redeem reported working promo codes for free rolls." },
  { title: "Class Tier List", href: "/tier-list", desc: "Check community rankings and meta testing." },
  { title: "Classes Guide", href: "/classes", desc: "Learn all 6 archetypes: Warrior, Mage, Rogue & more." }
];

const officialDiscordUrl = "https://discord.com/invite/CVXghKVQSH";
const officialRobloxGroupUrl = "https://www.roblox.com/communities/889770537/odanos";
const lastUpdatedDate = "November 16, 2026";
---

<Base
  title={title}
  description={description}
  h1={h1}
  siblingLinks={siblingLinks}
>
  <div style="margin-bottom: 1.5rem;">
    <span class="badge badge-amber">Community Notice</span>
    <h1 style="margin-top: 0.75rem;">{h1}</h1>
    <div class="meta-banner">
      <span><strong>Status:</strong> No Official Public Board</span>
      <span>&bull;</span>
      <span><strong>Fact-Checked:</strong> {lastUpdatedDate}</span>
    </div>
    <p>
      Searching for the official <strong>Fallen Lineage Trello</strong>? Here is the honest, verified breakdown of where developer updates, balance notes, and game resources actually live.
    </p>
  </div>

  <!-- Hero Truth Card: Top Most Prominent Section -->
  <section style="margin-top: 1.5rem; margin-bottom: 2.5rem;">
    <div class="card" style="border: 2px solid var(--accent-amber); background: linear-gradient(135deg, rgba(22, 27, 46, 0.95), rgba(12, 15, 25, 0.95)); padding: 2.25rem; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08);">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
        <span class="badge" style="background-color: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.85rem; padding: 0.35rem 0.85rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">
          ⚠️ Direct Fact Check
        </span>
        <span class="badge badge-amber">Developer Status: Discord Only</span>
      </div>
      <h2 style="border: none; margin-top: 0.25rem; margin-bottom: 1rem; font-size: 1.75rem; color: #ffffff; letter-spacing: -0.01em;">
        Fallen Lineage Does Not Have an Official Public Trello Board
      </h2>
      <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.75; margin-bottom: 1.75rem;">
        As of November 2026, the creator of Fallen Lineage (<strong>odanos</strong>) does <strong>not</strong> operate a verified public Trello workspace. All legitimate development roadmaps, patch previews, and reward announcements are communicated exclusively through the two official community channels below:
      </p>

      <div class="grid grid-cols-2" style="margin-top: 1.25rem; gap: 1.25rem;">
        <div class="card" style="background: rgba(14, 18, 30, 0.8); border: 1px solid rgba(56, 189, 248, 0.25); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="font-size: 1.5rem;">💬</span>
              <h3 style="margin: 0; color: #38bdf8; font-size: 1.2rem;">Official Discord Community</h3>
            </div>
            <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
              The primary developer hub for real-time announcements, server shutdown compensation notices, balance debates, and game sneak peeks.
            </p>
          </div>
          <a
            href={officialDiscordUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="width: 100%; text-align: center; justify-content: center;"
          >
            Join Official Discord &rarr;
          </a>
        </div>

        <div class="card" style="background: rgba(14, 18, 30, 0.8); border: 1px solid rgba(245, 158, 11, 0.25); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
              <span style="font-size: 1.5rem;">👥</span>
              <h3 style="margin: 0; color: var(--accent-amber-light); font-size: 1.2rem;">Official Roblox Group (odanos)</h3>
            </div>
            <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
              The verified creator group on Roblox. Joining this group is also an in-game requirement to unlock promo code redemptions and community status.
            </p>
          </div>
          <a
            href={officialRobloxGroupUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
            style="width: 100%; text-align: center; justify-content: center;"
          >
            Visit Roblox Group &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Beware of Misleading External Links -->
  <section style="margin-top: 3rem;">
    <h2>Beware of Misleading Trello Links Online</h2>
    <p>
      Several automated scrapers, YouTube descriptions, and low-quality wikis post incorrect Trello links for Fallen Lineage:
    </p>

    <div class="callout">
      <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-primary);">Common Misconceptions & False Boards:</h3>
      <ul style="margin-bottom: 0; padding-left: 1.25rem;">
        <li>
          <strong>The Arcane Odyssey Card (TJdNiq1k):</strong> The widely circulated URL <code>trello.com/c/TJdNiq1k</code> actually belongs to an entirely different game—<em>Arcane Odyssey</em> (specifically Card #35 "Next Update Info / General Roadmap"). It has no connection to Fallen Lineage.
        </li>
        <li>
          <strong>Fabricated Wiki Columns:</strong> Some scraped sites describe Naruto-themed features (such as clans, chakra points, and jutsu). Fallen Lineage is a medieval turn-based roguelite featuring 6 combat classes (Warrior, Rogue, Mage, Lancer, Bard, Archer), not an anime simulator.
        </li>
        <li>
          <strong>Phishing Risks:</strong> Never enter your Roblox credentials on third-party boards claiming to offer free spins or admin privileges.
        </li>
      </ul>
    </div>
  </section>

  <section style="margin-top: 3rem;">
    <h2>Where to Get Verified Game Information</h2>
    <p>
      Since no public Trello exists, explore our verified wiki guides to master game mechanics and claim current rewards:
    </p>
    <div class="grid grid-cols-2" style="margin-top: 1.25rem;">
      <a href="/codes" class="card" style="text-decoration: none; display: block;">
        <div class="card-title">
          <span>🎁 Active Codes</span>
          <span class="badge badge-green">Free Rewards</span>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary);">
          Check our updated Roblox codes list for reported working Reset Orbs, reroll tokens, and extra lives.
        </p>
      </a>

      <a href="/classes" class="card" style="text-decoration: none; display: block;">
        <div class="card-title">
          <span>⚔️ All 6 Classes</span>
          <span class="badge badge-amber">Archetypes</span>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary);">
          In-depth breakdowns for Warrior, Rogue, Mage, Lancer, Bard, and Archer playstyles and tactical roles.
        </p>
      </a>

      <a href="/tier-list" class="card" style="text-decoration: none; display: block;">
        <div class="card-title">
          <span>🏆 Class Tier List</span>
          <span class="badge badge-amber">Rankings</span>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary);">
          Review current dungeon clearing benchmarks, survival ratios, and community verification progress.
        </p>
      </a>

      <a href="/guides/beginner" class="card" style="text-decoration: none; display: block;">
        <div class="card-title">
          <span>📖 Beginner Guide</span>
          <span class="badge badge-amber">Walkthrough</span>
        </div>
        <p style="margin-bottom: 0; font-size: 0.925rem; color: var(--text-secondary);">
          Master turn order, action points, core mechanics, and survive your first brutal dungeon runs.
        </p>
      </a>
    </div>
  </section>
</Base>
