---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  h1?: string;
  type?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
  siblingLinks?: Array<{ title: string; href: string; desc: string }>;
}

const {
  title,
  description,
  h1,
  type = 'article',
  datePublished = '2026-11-16T10:40:00Z',
  dateModified = '2026-11-16T10:40:00Z',
  siblingLinks = [],
  extraSchemas = []
} = Astro.props;

const extraSchemasList = Array.isArray(extraSchemas) ? extraSchemas : (extraSchemas ? [extraSchemas] : []);

const pathname = Astro.url.pathname;
const cleanPath = pathname === '/' ? '' : pathname.replace(/\/+$/, '');
const canonicalURL = `https://fallenlineage.org${cleanPath}`;
const isHome = pathname === '/' || pathname === '';

const schemaData = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Fallen Lineage Wiki',
      url: 'https://fallenlineage.org',
      description: description
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: h1 || title,
      description: description,
      url: canonicalURL,
      datePublished: datePublished,
      dateModified: dateModified,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL
      },
      publisher: {
        '@type': 'Organization',
        name: 'Fallen Lineage Wiki',
        url: 'https://fallenlineage.org'
      }
    };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Fallen Lineage Wiki" />
    <meta property="og:image" content="https://fallenlineage.org/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fallenlineage.org/og-image.png" />

    <!-- Fonts: Classical Display Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    {extraSchemasList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <!-- Umami 自建流量统计（2KB 极轻量、免 Cookie、抗拦截） -->
    {(import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || process.env.PUBLIC_UMAMI_WEBSITE_ID) && (
      <script
        defer
        src={(import.meta.env.PUBLIC_UMAMI_HOST_URL || process.env.PUBLIC_UMAMI_HOST_URL || 'https://umami-pied-six.vercel.app') + '/script.js'}
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || process.env.PUBLIC_UMAMI_WEBSITE_ID}
      />
    )}
    <!-- PVUV.ai 流量统计（内置 Bot 识别与清洗） -->
    <script is:inline>window.pvuv=window.pvuv||function(){(window.pvuv.q=window.pvuv.q||[]).push(arguments)}</script>
    <script
      defer
      src="https://www.pvuv.ai/f.js"
      data-site={import.meta.env.PUBLIC_PVUV_SITE_ID || process.env.PUBLIC_PVUV_SITE_ID || "cAowTXWz"}
      data-api="https://in.pvuv.ai"
    ></script>

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3924907645674919"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <Header currentPath={cleanPath || '/'} />
    <main>
      <div class="container">
        <slot />

        {siblingLinks.length > 0 && (
          <aside class="sibling-nav">
            <h2 class="sibling-nav-title">Related Fallen Lineage Resources</h2>
            <div class="sibling-grid">
              {siblingLinks.map((link) => (
                <a href={link.href} class="sibling-card">
                  <strong>{link.title}</strong>
                  <span>{link.desc}</span>
                </a>
              ))}
            </div>
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
